{% extends '../item-summary.njk' %}
{% from '../../dictionary/term-macros.njk' import termSummary %}
{% block itemName %}{{ item.title }}{% endblock %}
{% block itemHeader %}
  {{ super() }}
  {% if item._institutions %}
      {% for institution in item._institutions %}
        {{ termSummary(createTerm(institution, 'institutions'), createTerm, termList, true) }}
      {% endfor %}
  {% endif %}
{% endblock %}
{% block itemBelowName %}
  {% if item.department %}<span class="h4">{{ item.department }}</span>{% endif %}
  {{ super() }}
{% endblock %}
{% block itemBelowNameList %}
  {% if item.fullTime or item.partTime or item.modality %}
    <li class="my-1">
      {% if item.fullTime %}
        <span>Full time</span>
      {% elif item.partTime %}
        <span>Part time</span>
      {% endif %}
      {% if item.modality %}
        {% if item.fullTime or item.partTime %}
          <span class="theme-color-text">&bull;</span>
        {% endif %}
        <span>
          {% if item.modality == 'remote' %}
            Remote
          {% elif item.modality == 'hybrid' %}
            Hybrid
          {% elif item.modality == 'on-site' %}
            On-site
          {% endif %}
        </span>
      {% endif %}
    </li>
  {% endif %}
  {{ super() }}
{% endblock %}
